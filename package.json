{
  "name": "promptforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "npx -y concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "seed": "npm run seed --prefix backend",
    "guardrail": "npm run guardrail --prefix backend",
    "test:regression": "npm run test:regression --prefix backend"
  }
}
