{
  "name": "promptforge-backend",
  "version": "1.0.0",
  "description": "Decoupled LangChain & Supabase pgvector RAG Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "restart": "powershell -Command \"$p=(netstat -ano|findstr ':8000.*LISTENING'|ForEach-Object{($_ -split '\\s+')[-1]}|Select-Object -First 1); if($p){taskkill /PID $p /F}; node server.js\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.0",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/groq": "^1.2.1",
    "@supabase/supabase-js": "^2.43.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "promptforge-monorepo": "file:..",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
